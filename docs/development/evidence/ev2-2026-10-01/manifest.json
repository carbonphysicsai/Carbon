  "contract": {
    "acceptance": {
      "hypotheses": {
        "H1": "Primary: Kendall tau between the development-chosen rule's model ranking and the decision-loss ranking on the verification conditions (reconstructed members only). Reported with the control's and every other rule's tau; no significance claim at this panel size.",
        "H2": "Pass/fail: dar-p0-r100-a0 scores the labelled boundary-optimist control below every eligible reconstructed member. Reported for every rule.",
        "interpretation": "H2 shows sensitivity to one constructed failure mode (optimism at the limits), not that the component catches every unsafe model. Neither outcome changes the testnet rule; a change needs its own prospective decision."
      },
      "rule_selection": "on development scenarios, choose the profile whose model ranking has the highest Kendall tau with the decision-loss ranking; ties go to the control",
      "success_condition": "Carbon can compare several models on the same engineering decision and show whether its scoring prefers models that select better reference-verified designs",
      "verification": "freeze the chosen profile, then report its agreement on the verification scenarios; revising after inspecting them makes them development evidence"
    },
    "authority": {
      "chain": false,
      "changes_testnet_rule": false,
      "qualification": false,
      "record": "the owner's 2026-09-29 approval of EV2 and the decision-aware robustness component (programme state items 14 and 15)",
      "reward": false
    },
    "baseline": {
      "method": "fixed conservative default declared before any evaluation",
      "protocol": {
        "c1": 0.75,
        "c2": 0.6
      }
    },
    "budgets": {
      "compute": "CPU; no paid resources",
      "reconstructions_max": 16,
      "reference_solves_max": 560
    },
    "case_prefix": "ev2",
    "challenge": {
      "id": "battery-fastcharge-ageing-development-v1",
      "version": "1.0"
    },
    "constraints": [
      {
        "id": "reach_cv_in_window",
        "quantity": "time_to_cv_onset_s",
        "rule": "reached within the window",
        "unit": "s"
      },
      {
        "id": "no_plating_onset",
        "meaning": "cycle-1 minimum plating overpotential stays non-negative",
        "quantity": "plating_margin_v",
        "rule": ">=",
        "threshold": 0.0,
        "unit": "V"
      },
      {
        "id": "peak_temperature",
        "meaning": "maximum volume-averaged temperature over the first hour",
        "quantity": "peak_temperature_c",
        "rule": "<=",
        "threshold": 45.0,
        "unit": "degC"
      }
    ],
    "contract_id": "ev2-battery-charge-protocol-selection",
    "data_scope": {
      "classification": "PUBLIC_SYNTHETIC",
      "permitted_use": "public DEVELOPMENT evidence; no client material; client studies require the private execution route"
    },
    "decision": {
      "adaptation": "one protocol per operating condition (each scenario holds exactly one condition)",
      "changes_from_ev1": [
        "per-condition decisions instead of the worst case over four conditions (EV1 finding 1: no verification scenario had a feasible protocol)",
        "the candidate grid spans the full generator range of c1 and c2 in even steps",
        "fresh development and verification conditions, none an EV1 condition",
        "three more recipe families (DeepONet, a wide shallow MLP, 15-neighbour kNN), so the panel is more than repeated seeds",
        "decision-aware profiles whose robustness leg is the decision agreement component"
      ],
      "claim_scope": "Charging speed is measured as time to constant-voltage onset (the voltage proxy below), not time to a target state of charge. The 30-cycle reference is not extrapolated to real-cell lifetime or safety.",
      "intended_use": "Public synthetic DEVELOPMENT study (EV2): does Carbon's scoring prefer models that select better reference-verified protocols, and does a decision-aware robustness component catch models that are accurate but optimistic at the limits? Not a cell qualification, lifetime, warranty or safety claim.",
      "statement": "For each declared operating condition, select from a fixed grid of two-stage fast-charge protocols the one that reaches the constant-voltage phase soonest while meeting every constraint in that condition, or abstain if none qualifies.",
      "unchanged_from_ev1": "objective, constraints and thresholds, uncertainty bands, mistake costs, minimum useful improvement, baseline, tie rule, reference, scoring set, EV1 weight profiles and the rule-selection rule"
    },
