  "contract": {
    "acceptance": {
      "rule_selection": "on development scenarios, choose the profile whose model ranking has the highest Kendall tau with the decision-loss ranking; ties go to the control",
      "success_condition": "Carbon can compare several models on the same engineering decision and show whether its scoring prefers models that select better reference-verified designs",
      "verification": "freeze the chosen profile, then report its agreement on the verification scenarios; revising after inspecting them makes them development evidence"
    },
    "authority": {
      "chain": false,
      "changes_testnet_rule": false,
      "qualification": false,
      "record": "the owner's 2026-09-25 engineering-value direction",
      "reward": false
    },
    "baseline": {
      "method": "fixed conservative default declared before any evaluation",
      "protocol": {
        "c1": 0.75,
        "c2": 0.6
      }
    },
    "budgets": {
      "compute": "CPU; no paid resources",
      "reconstructions_max": 16,
      "reference_solves_max": 384
    },
    "challenge": {
      "id": "battery-fastcharge-ageing-development-v1",
      "version": "1.0"
    },
    "constraints": [
      {
        "id": "reach_cv_in_window",
        "quantity": "time_to_cv_onset_s",
        "rule": "reached within the window",
        "unit": "s"
      },
      {
        "id": "no_plating_onset",
        "meaning": "cycle-1 minimum plating overpotential stays non-negative",
        "quantity": "plating_margin_v",
        "rule": ">=",
        "threshold": 0.0,
        "unit": "V"
      },
      {
        "id": "peak_temperature",
        "meaning": "maximum volume-averaged temperature over the first hour",
        "quantity": "peak_temperature_c",
        "rule": "<=",
        "threshold": 45.0,
        "unit": "degC"
      }
    ],
    "contract_id": "ev1-battery-charge-protocol-selection",
    "data_scope": {
      "classification": "PUBLIC_SYNTHETIC",
      "permitted_use": "public DEVELOPMENT evidence; no client material; client studies require the private execution route"
    },
    "decision": {
      "adaptation": "one protocol per scenario; no per-condition protocol choice",
      "claim_scope": "Charging speed is measured as time to constant-voltage onset (the voltage proxy below), not time to a target state of charge. The 30-cycle reference is not extrapolated to real-cell lifetime or safety.",
      "intended_use": "Public synthetic DEVELOPMENT study: does Carbon's scoring prefer models that select better reference-verified protocols? Not a cell qualification, lifetime, warranty or safety claim.",
      "statement": "Given a fixed set of two-stage fast-charge protocols and declared operating conditions, select the protocol that reaches the constant-voltage phase soonest in the worst declared condition while meeting every constraint in every declared condition, or abstain if none qualifies."
    },
    "design_variables": {
      "c1": {
        "allowed": [
          0.75,
          1.25,
          1.75,
          2.0
        ],
        "meaning": "first-stage constant-current rate, until 4.0 V",
        "unit": "C"
      },
      "c2": {
        "allowed": [
          0.4,
          0.6,
          0.8,
          1.0
        ],
        "meaning": "second-stage constant-current rate, until 4.2 V",
        "unit": "C"
      }
    },
    "minimum_useful_improvement_s": 120.0,
    "mistake_costs": {
      "false_acceptance": 10.0,
      "missed_opportunity": 1.0,
      "regret_per_minimum_useful_improvement": 1.0,
      "status": "PROVISIONAL_DEVELOPMENT",
      "unit": "multiples of the minimum useful improvement"
    },
    "models": {
      "prediction_access": "models receive only design variables and operating conditions; reference answers are never visible to training or selection",
      "reconstruction": "Carbon rebuilds each declared recipe with its declared seed through the battery construction contract",
      "repetition": "reconstruction seeds are repetitions of one recipe, never separate model families",
      "training_data": "public TRAIN v1 only"
    },
    "objective": {
      "charge_start_s": 120.0,
      "definition": "For each condition, the time from charge start (the end of the reference's 120 s initial rest) to the first crossing of the terminal voltage above 4.19 V on the 30 s grid, by linear interpolation; the objective is the maximum over the scenario's conditions.",
      "name": "worst_case_time_to_cv_onset",
      "sense": "minimize",
      "threshold_v": 4.19,
      "unit": "s",
      "unreached": "NOT_REACHED_IN_WINDOW: the protocol fails the reach constraint in that condition; its objective is undefined, never the window length.",
      "window_s": 3600.0
    },
    "operating_conditions": {
