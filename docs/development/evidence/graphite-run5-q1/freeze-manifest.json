  "contract": {
    "acceptance": {
      "hypotheses": {
        "H1": "Primary, paired: delta_tau = tau(dar-p0-r100-a0) - tau(control-exam-v1). Each tau is Kendall tau-b between the rule's ranking of the eligible reconstructed members and their decision-loss ranking on the 12 verification conditions. 95 % paired bootstrap interval, resampling members and conditions jointly, B = 10000, RNG seed 20261001. An interval that excludes 0 decides H1 in the direction of its sign; otherwise H1 is UNRESOLVED, never 'no difference'.",
        "H2": "As EV2: dar-p0-r100-a0 scores the labelled boundary-optimist control below every eligible reconstructed member. Reported for every rule.",
        "H3": "The real-model blind spot: the number of eligible reconstructed members that commit a reference-verified false acceptance (a selected protocol verified INFEASIBLE) on any verification condition, and each such member's rank under both rules.",
        "continuity": "EV2's rule-selection procedure is kept: the development-chosen rule and its verification tau are reported.",
        "interpretation": "H2 shows sensitivity to one constructed failure mode, not that the component catches every unsafe model. No outcome changes the testnet rule; a change needs its own prospective decision."
      },
      "paired_comparison": {
        "deciding_rule": "control-exam-v1",
        "decision": "an interval excluding 0 decides H1 in its sign's direction; otherwise UNRESOLVED",
        "hypothesis": "H1",
        "interval": "percentile",
        "level": 0.95,
        "pool": "eligible reconstructed members",
        "proposed_rule": "dar-p0-r100-a0",
        "replicates": 10000,
        "resample": "members and conditions jointly, with replacement",
        "rng": "numpy.random.default_rng (PCG64)",
        "rng_seed": 20261001,
        "split": "verification",
        "statistic": "kendall_tau_b(proposed) - kendall_tau_b(deciding)"
      },
      "rule_selection": "on development scenarios, choose the profile whose model ranking has the highest Kendall tau with the decision-loss ranking; ties go to the control",
      "success_condition": "Carbon can compare several models on the same engineering decision and show whether its scoring prefers models that select better reference-verified designs",
      "verification": "freeze the chosen profile, then report its agreement on the verification scenarios; revising after inspecting them makes them development evidence"
    },
    "authority": {
      "chain": false,
      "changes_testnet_rule": false,
