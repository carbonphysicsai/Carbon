  },
  "reported_not_scored": ["safety_counts", "missed_opportunity", "ceiling_capture", "coverage", "excluded_class_counts", "reuse_strata", "cheap_arm_margin"],
  "lambda_deployed_failure_cost": "UNMEASURED_NOT_IN_U",
