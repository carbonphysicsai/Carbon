{
  "applies_to": "EVERY_DECLARED_CONDITION",
  "challenge": {
    "id": "chip-cold-plate",
    "version": "1.0"
  },
  "constraints": {
    "die_peak_c_max": 100.0,
    "hydraulic_power_w_max": 0.25
  },
  "inclusive_boundaries": true,
  "quantity_mapping": {
    "die_peak_c": "carbon.cold_plate.exam.die_peak_c(case, outputs)",
    "feasible": "die_peak_c <= die_peak_c_max and hydraulic_w <= hydraulic_power_w_max",
    "hydraulic_w": "pressure_drop_pa * derived(case).flow_m3_s",
    "total_flow_lpm": "flow_lpm_per_kw * heat_load_w / 1000"
  },
  "role": "important_limit_definition",
  "scenario": {
    "control_policy": {
      "assumption": "An implementable supervisory controller receives a commanded or measured steady-state heat load and commands pump flow proportionally before each settled operating point.",
      "equation": "total_flow_lpm = flow_lpm_per_kw * heat_load_w / 1000",
      "name": "steady-state-feed-forward-flow-per-heat",
      "not_demonstrated": [
        "transient response",
        "sensor error or latency",
        "pump and actuator dynamics",
        "manifold flow distribution",
        "controller safety qualification"
      ],
      "required_limits": [
        "declared flow_lpm_per_kw design bounds",
        "synthetic hydraulic-power constraint",
        "PG25 reference property applicability",
        "reference laminar Reynolds applicability",
        "future owner-approved pump flow, pressure and slew limits"
      ]
    },
    "customer_requirement_ref": "synthetic:ai-accelerator-cooling-v1",
    "description": "Synthetic steady-state accelerator cold-plate decision study; not a customer requirement or acceptance test.",
    "die_limit_c": 100.0,
    "hydraulic_limit_w": 0.25
  },
