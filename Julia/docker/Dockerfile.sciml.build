# docker/Dockerfile.sciml.build
FROM julia:1.10-bullseye AS builder

RUN apt-get update && apt-get install -y \
    python3 python3-pip curl git && \
    rm -rf /var/lib/apt/lists/*

RUN julia --project -e '
    using Pkg
    Pkg.add([
        "DifferentialEquations", "NeuralPDE", "ModelingToolkit",
        "SciMLSensitivity", "MethodOfLines", "NeuralPDE",
        "Symbolics", "Optimization", "OptimizationOptimizers",
        "HTTP", "JSON3", "Sockets", "CUDA"
    )
    Pkg.precompile()
'

RUN pip install httpx numpy jax jaxlib

COPY julia /app/julia

FROM julia:1.10-bullseye AS runtime
COPY --from=builder /root/.julia /root/.julia
COPY --from=builder /app /app

ENV JULIA_DEPOT_PATH=/opt/julia/depot
ENV JULIA_NUM_THREADS=16

EXPOSE 8083
CMD ["julia", "--project", "/app/start_server.jl"]
