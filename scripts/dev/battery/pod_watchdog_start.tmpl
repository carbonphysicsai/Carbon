bash -c 'set -e; . /etc/os-release; [ "$ID" = ubuntu ] || { echo NOT_UBUNTU; sleep infinity; }; export DEBIAN_FRONTEND=noninteractive; apt-get update -qq && apt-get install -y -qq --no-install-recommends openssh-server >/dev/null; dpkg-query -W openssh-server; useradd -m -d /var/lib/carbon-producer/startup -s /bin/bash carbon-producer || true; install -d -m 700 -o carbon-producer /var/lib/carbon-producer/startup/.ssh; echo "$PUBLIC_KEY" > /var/lib/carbon-producer/startup/.ssh/authorized_keys; chown carbon-producer /var/lib/carbon-producer/startup/.ssh/authorized_keys; chmod 600 /var/lib/carbon-producer/startup/.ssh/authorized_keys; install -d -m 755 -o carbon-producer /opt/carbon-worker /opt/uv-python /carbon /var/lib/carbon-producer/watchdog; D=$(( $(date +%s) + {MAXLIFE} )); echo "MAX_LIFETIME_UNTIL $(date -u -d @$D +%FT%TZ)"; ( set +e; shopt -s execfail; while [ "$(date +%s)" -lt "$D" ]; do if [ -x /opt/carbon-worker/bin/python ] && [ -f /var/lib/carbon-producer/watchdog/watchdog.py ]; then install -m 700 /var/lib/carbon-producer/watchdog/watchdog.py /root/watchdog.py && echo "{HASH}  /root/watchdog.py" | sha256sum -c --status && exec /opt/carbon-worker/bin/python -I /root/watchdog.py "$D"; fi; sleep 15; done; echo WATCHDOG_NEVER_ARMED ) & ssh-keygen -A; mkdir -p /run/sshd; echo READY; exec /usr/sbin/sshd -D -e -o PasswordAuthentication=no -o PermitRootLogin=no'
