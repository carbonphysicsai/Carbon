# F08 (Ribbed Bracket) 1.2 sealed exam: the common runner's config (OWNER-F02-F08-EXAM-DRAW-01;
# OWNER-CADENCE-AND-ROTATION-02; VALIDATOR_F08_SEALED_STOP_20261022). Sourced by run_sealed.sh.
# F08's solves run inside the verified native build (CalculiX/gmsh image 22a7902f), so this config supplies
# the runner's hooks: prepare() (in-image preflight and mounts), sizing() (the public cost/identity PROBE:
# stop unless the lineage's h = 1.7 values are bit-identical; parallel from the probe's largest rung RSS),
# run_solve(), and u_coverage_run() (the reference-uncertainty panel v2, the Roache method of the committed
# method script). Pack and QA are the payload's pack_batch.py and f08_qa.py; the C5 decision stage is
# carbon/f08/decision_check.py.
CHALLENGE_KEY=f08
CID=f08-ribbed-bracket
DEFAULT_ROLE=f08-sealed-exam
RECORD=OWNER-CADENCE-AND-ROTATION-02
RECORD_FILE=2026-10-20-OWNER-CADENCE-AND-ROTATION-02.md
CUSTODY_DIR=f08
VENV=venv-system
VENV_PYTHON=/usr/bin/python3
OUT_PREFIX=f08-sealed
DEPLOYMENT_SCHEMA=carbon.f08.hidden-deployment.v1
SOURCE_MODULE=carbon.challenge_validator.f08_source
SOURCE_INIT_ARGS=
SOLVERS_ID=sha256:adcdd02bcb9a906046d8276f797f2c7f2c79bcc8745546cd35407a70bebd86a2
IMAGE=sha256:22a7902fcd32a3bc454e7617e775b1be39e77e4826f6fc1ddd43ad534378539d
PROBE_MODE=hook
PACK_SCRIPT=pack_batch.py
QA_SCRIPT=f08_qa.py
DECISION_KEY=f08
BATCH_WALL_LIMIT_S=21600
LINEAGE_WORST=0.15506179762858988
LINEAGE_STATIC=0.001677611
OLD_RECORD=docs/development/evidence/f08-near-limit-public-20261020/reference-uncertainty/f08-reference-uncertainty.json

IMG() { F08_DOCKER_IMAGE="$IMAGE" PY "$STATE/f08_in_image.py" "$@"; }

prepare() {
  test -f "$repo/.agent/decisions/2026-10-21-OWNER-F08-REBUILD-MMS-ACCEPT-01.md"
  IMG preflight > "$out/preflight.log" 2>&1 || { echo "STOP: in-image preflight failed (see preflight.log)" >&2; exit 1; }
  cp "$STATE/probe-plan.json" "$out/"
  IMG mounts "$out/probe-plan.json" "$out" >> "$out/preflight.log" 2>&1 \
    || { echo "STOP: the probe's mounts do not work in the image (see preflight.log)" >&2; exit 1; }
}

# the probe: a public ladder geometry (RR-PACKS-07 pilot-0000) through the family runner in the image. STOP unless
# OK, the pinned identity, and worst dynamic and static compliance at h = 1.7 equal the rebuild lineage's values
# (same host class, image and pinned core, so bit-identical; bound 0 is a working decision for the Validator).
# Parallel = min(0.7 x available memory (the slot's cap, if slotted) / the probe's largest rung RSS, cores / 2), at least 1.
sizing() {
  local probe_rc=0
  IMG probe "$out/probe-plan.json" "$out/probe" > "$out/probe.log" 2>&1 || probe_rc=$?
  PY - "$out" "$probe_rc" "$(awk '/^MemAvailable:/{printf "%d", $2/1024}' /proc/meminfo)" "${SLOT_CORES:-$(nproc)}" \
      "$SOLVERS_ID" "$LINEAGE_WORST" "$LINEAGE_STATIC" "${SLOT_MEM_MIB:-0}" <<'PYEOF'
import json, math, sys
BOUND = 0.0  # working decision (Validator): same host, image and pinned core as the lineage
out, rc = sys.argv[1], int(sys.argv[2])
avail, cpus = float(sys.argv[3]), float(sys.argv[4])
solvers_id, want_worst, want_static = sys.argv[5], float(sys.argv[6]), float(sys.argv[7])
cap = float(sys.argv[8])
if cap:
    avail = min(avail, cap)  # a slot job may use its cap, not the whole host
record = json.loads(open(out + "/probe/run/records.jsonl").readline())
status = record["status"]
outputs = record.get("outputs") or {}
deltas = {}
for key, want in (("worst_dynamic_mm_per_n", want_worst), ("static_tip_mm_per_n", want_static)):
    value = outputs.get(key)
    deltas[key] = None if value is None else abs(value - want)
rss = [r.get("sampled_group_rss_peak_bytes") for r in (record.get("rungs") or {}).values()]
rss = [v for v in rss if type(v) in (int, float) and v > 0]
peak_mib = max(rss) / 2**20 if rss else None
limits = {"memory": math.floor(0.7 * avail / peak_mib) if peak_mib else None, "cpus": math.floor(cpus / 2)}
parallel = max(1, min(v for v in limits.values() if v is not None))
stop = (status != "OK" or record.get("image") != solvers_id or record.get("candidate")
        or peak_mib is None or any(d is None or d > BOUND for d in deltas.values()))
walls = {h: r.get("wall_s") for h, r in (record.get("rungs") or {}).items()}
json.dump({"schema": "carbon.sealed-f08-probe.v1", "status": status, "runner_rc": rc,
           "reasons": record.get("reasons", []), "image": record.get("image"),
           "outputs_h1_7": {k: outputs.get(k) for k in deltas},
           "lineage_h1_7": {"worst_dynamic_mm_per_n": want_worst, "static_tip_mm_per_n": want_static},
           "abs_delta": deltas, "bound": BOUND, "rung_wall_s": walls,
           "peak_rung_rss_mib": peak_mib, "available_memory_mib": avail, "cpus": cpus, "slot_cap_mib": cap or None,
           "limits": limits, "parallel": parallel, "stop": bool(stop)},
          open(out + "/probe.json", "w"), indent=1)
print(json.dumps({"probe": status, "abs_delta": deltas, "parallel": parallel, "stop": bool(stop)}))
sys.exit(1 if stop else 0)
PYEOF
  parallel=$(PY -c "import json,sys; print(json.load(open(sys.argv[1]))['parallel'])" "$out/probe.json")
}

run_solve() { ( cd "$repo" && IMG solve "$priv/config.json" "$1" "$parallel" 7200 ) >> "$priv/logs/solve-${1#sha256:}.log" 2>&1; }

# the reference-uncertainty panel v2 (VALIDATOR_F08_SEALED_STOP_20261022, STOP 2): 8 PUBLIC cases drawn by the F08
# exam law with the recorded public seed 20261022, each solved at h = 3, 2.25, 1.7 mm, then the Roache non-uniform U
# exactly as the committed method script does it. The only custody touched is a READ of the batches' geometries to
# prove the panel is disjoint from them (a count, never a value). STOP if any case has p < 0.5 or non-monotone rungs,
# a case is not OK, or a panel geometry equals a sealed one. Output: $out/{plan.json, disjoint.json, run/, u-panel-v2.json}.
u_coverage_run() {
  test -f "$repo/$OLD_RECORD"
  test -f "$priv/config.json"
  ( cd "$repo" && PY "$STATE/f08_upanel.py" plan "$out/plan.json" ) > "$out/plan.log"
  IMG mounts "$out/plan.json" "$out" >> "$out/preflight.log" 2>&1 || { echo "STOP: the mounts do not work in the image" >&2; exit 1; }
  ( cd "$repo" && PY "$STATE/f08_upanel.py" disjoint "$priv/config.json" "$out/plan.json" ) > "$out/disjoint.json" \
    || { echo "STOP: a panel geometry equals a sealed one (see disjoint.json)" >&2; exit 1; }
  if [ "${DRY:-0}" = 1 ]; then echo "DRY=1: verified files, code, image, preflight, mounts, the public plan and its disjointness; no solve"; exit 0; fi
  local width=${PARALLEL:-8}
  if [ -n "$SLOT_CORES" ] && [ "$width" -gt "$SLOT_CORES" ]; then width=$SLOT_CORES; fi
  echo "{\"parallel\": $width}" > "$out/panel-sizing.json"
  ( cd "$repo" && IMG panel "$out/plan.json" "$out/run" "$width" ) > "$out/panel.log" 2>&1 \
    || { echo "STOP: the panel run failed (see panel.log)" >&2; exit 1; }
  ( cd "$repo" && PY "$STATE/f08_upanel.py" compute "$out/run/records.jsonl" "$repo/$OLD_RECORD" "$out/u-panel-v2.json" )
}
