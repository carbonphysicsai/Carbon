# F02 (Burst Thermal) 2.1 sealed exam: the common runner's config (OWNER-F02-F08-EXAM-DRAW-01).
# Sourced by run_sealed.sh; values are F02's own (carbon.challenge_validator.f02_hidden).
CHALLENGE_KEY=f02
CID=f02
DEFAULT_ROLE=f02-sealed-exam
RECORD=OWNER-CADENCE-AND-ROTATION-02
RECORD_FILE=2026-10-20-OWNER-CADENCE-AND-ROTATION-02.md
CUSTODY_DIR=f02
VENV=venv-system                 # system python3: RR-04's level-2 mesh node bits
VENV_PYTHON=/usr/bin/python3
OUT_PREFIX=f02-sealed
DEPLOYMENT_SCHEMA=carbon.f02.hidden-deployment.v1
SOURCE_MODULE=carbon.challenge_validator.f02_source
SOURCE_INIT_ARGS=
# the rebuilt Elmer image (OWNER-F02-REBUILD-MMS-ACCEPT-01); the runner reads it from CARBON_F02_IMAGE
IMAGE=sha256:fe8a5b1abebf56bbd9cd1aae2ee08f1825b2991abc0bb14b5be3fae26e6512ec
RUNNER=scripts/dev/reference_packages/elmer/f02_exam_runner.py
RUNNER_IMAGE_ENV=CARBON_F02_IMAGE
RUNNER_IMAGE_VALUE=$IMAGE
# probe: the public cold action cool-rect-low through the family runner, exact to RR-04's value (Validator)
PROBE_NAME_PREFIX=carbon-f02x-
PROBE_PARALLEL=3
PROBE_MEM_DIV=3                  # the probe runs its 3 rungs at once: per-case memory = peak / 3
PROBE_KEY=peak_top_c
PROBE_EXPECT=90.78052055710003
PROBE_BOUND=0.001
PACK_SCRIPT=pack_batch.py
QA_SCRIPT=f02_qa.py
BATCH_WALL_LIMIT_S=21600
