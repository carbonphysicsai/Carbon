# Battery 4x35 sealed exam: the common runner's config (OWNER-CADENCE-AND-ROTATION-02;
# VALIDATOR_BATTERY_SEALED_RULINGS_20261022). Sourced by run_sealed.sh.
# Battery's solves run inside the pinned truth image (PyBaMM overlay), so this config supplies the
# runner's hooks: prepare() (overlay + in-image preflight), sizing() (no probe: the mesh-80/160/320 cost
# probe was its own priced step), run_solve(), price_check() and qa_run(). Needs the Validator's registered
# plating U record: U_RECORD and U_SHA256 (a real run refuses without them, so no solve is spent without a QA).
CHALLENGE_KEY=battery
CID=battery-sealed-exam
DEFAULT_ROLE=battery-sealed-exam
RECORD=OWNER-CADENCE-AND-ROTATION-02
RECORD_FILE=2026-10-20-OWNER-CADENCE-AND-ROTATION-02.md
CUSTODY_DIR=battery-sealed
VENV=venv-system
VENV_PYTHON=/usr/bin/python3
OUT_PREFIX=battery-sealed
DEPLOYMENT_SCHEMA=carbon.battery.sealed-deployment.v1
SOURCE_MODULE=carbon.challenge_validator.battery_sealed_source
SOURCE_INIT_ARGS=
IMAGE=ghcr.io/carbonphysicsai/carbon-determinism-study@sha256:2d19b261e722fe67f20bee02e115f2277a799c448b90d54d2872361b341bd940
PROBE_MODE=none
PACK_SCRIPT=pack_batch.py
QA_SCRIPT=battery_qa.py
BATCH_WALL_LIMIT_S=28800
# price bounds, stated up front: standard solve <= 2 x 236 s, mesh-160 solve <= 2 x 356 s, peak RSS (6.3 GB at mesh 160)
STD_MAX_S=472; M160_MAX_S=712; RSS_MAX_MB=8192
# the mesh-320 spot solves one at a time: the slot cap (or the free memory of an unslotted host) must be at least this
MIN_QA_MIB=${MIN_QA_FREE_MIB:-36864}
MEM_REQUIRED_MIB=$MIN_QA_MIB       # the largest container request (the mesh-320 spot solve, about 31 GB): a smaller slot is refused up front
U_RECORD=${U_RECORD:-}
U_SHA256=${U_SHA256:-}

overlay=$HOME/carbon-sealed/battery-overlay
IMG() { BATTERY_OVERLAY="$overlay" PY "$STATE/battery_in_image.py" "$@"; }

prepare() {
  if [ "${DRY:-0}" != 1 ]; then
    if [ -z "$U_RECORD" ] || [ -z "$U_SHA256" ]; then
      echo "STOP: U_RECORD and U_SHA256 (the Validator's registered Battery plating U) are required; with none there is no QA" >&2; exit 2
    fi
    echo "$U_SHA256  $U_RECORD" | sha256sum -c --quiet - || { echo "STOP: the U record does not match its sha256" >&2; exit 1; }
  fi
  ( cd "$repo" && PY "$STATE/overlay_build.py" "$overlay" ) > "$out/overlay.log" 2>&1 \
    || { echo "STOP: overlay build or verify failed (see overlay.log)" >&2; exit 1; }
  IMG preflight > "$out/preflight.log" 2>&1 || { echo "STOP: in-image preflight failed (see preflight.log)" >&2; exit 1; }
}

# parallel solves: memory (6.3 GB each at mesh 160, a 0.7 safety share) of the slot's cap or the host, and half the cores, at most 8
sizing() {
  local avail cores
  avail=$(awk '/^MemAvailable:/{printf "%d", $2/1024}' /proc/meminfo)
  if [ -n "$SLOT_MEM_MIB" ] && [ "$SLOT_MEM_MIB" -lt "$avail" ]; then avail=$SLOT_MEM_MIB; fi
  cores=${SLOT_CORES:-$(nproc)}
  parallel=$(( 7 * avail / 10 / 6400 ))
  [ "$parallel" -gt $(( cores / 2 )) ] && parallel=$(( cores / 2 ))
  [ "$parallel" -gt 8 ] && parallel=8
  [ "$parallel" -lt 1 ] && parallel=1
  export BATTERY_SOLVE_MEMORY="$(( parallel * 8 ))g"
  echo "{\"available_mib\": $avail, \"cores\": $cores, \"parallel\": $parallel}" > "$out/sizing.json"
}

run_solve() { ( cd "$repo" && IMG solve "$priv/config.json" "$1" "$parallel" 7200 ) >> "$priv/logs/solve-${1#sha256:}.log" 2>&1; }

price_check() {  # FP: public maxima only; rc 1 = over a bound
  PY - "$priv/producer/work/$CID/${1#sha256:}/records.jsonl" "$STD_MAX_S" "$M160_MAX_S" "$RSS_MAX_MB" <<'PYEOF'
import json, sys
path, std_max, m160_max, rss_max = sys.argv[1], *map(float, sys.argv[2:5])
rows = [json.loads(l) for l in open(path) if l.strip()]
ok = [r for r in rows if r.get("status") == "OK"]
peak = {"standard_wall_s": max((r["solves"]["standard"]["wall_s"] for r in ok), default=0),
        "m160_wall_s": max((r["solves"]["m160"]["wall_s"] for r in ok), default=0),
        "peak_rss_mb": max((max(r["solves"][k]["maxrss_mb"] for k in ("standard", "m160")) for r in ok), default=0),
        "ok_cases": len(ok)}
print(json.dumps(peak))
sys.exit(1 if peak["standard_wall_s"] > std_max or peak["m160_wall_s"] > m160_max or peak["peak_rss_mb"] > rss_max else 0)
PYEOF
}

qa_run() {  # FP: the onset straddle with U, then 3 seeded mesh-320 spot solves one at a time (battery_qa.py)
  local avail
  avail=$(awk '/^MemAvailable:/{printf "%d", $2/1024}' /proc/meminfo)
  if [ -n "$SLOT_MEM_MIB" ]; then
    # a slot's memory is its declared cap (the shim also caps the container to it)
    [ "$SLOT_MEM_MIB" -ge "$MIN_QA_MIB" ] || { echo "STOP: slot $SLOT's cap $SLOT_MEM_MIB MiB is below the $MIN_QA_MIB MiB the mesh-320 spot solves need; declare the slot at >= $MIN_QA_MIB" >&2; exit 1; }
  elif [ "$avail" -lt "$MIN_QA_MIB" ]; then
    echo "STOP: only $avail MiB free for the mesh-320 spot solves (need $MIN_QA_MIB); run alone" >&2; exit 1
  fi
  ( cd "$repo" && timeout 11000 env PYTHONPATH="$repo" BATTERY_OVERLAY="$overlay" "$venv/bin/python" "$STATE/$QA_SCRIPT" \
      judge "$priv/config.json" "$1" "$priv/qa/${1#sha256:}" "$U_RECORD" "$U_SHA256" )
}
