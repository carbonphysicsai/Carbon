FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}

// Verification values, not a coolant: constant properties chosen so that
// nu = mu/rho = 1e-6 m^2/s (Re 200 as in rungs 1-2) and Pr = 1, giving
// k = mu Cp / Pr = 4.181 W/m/K.
thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}
mixture
{
    specie          { molWeight 18; }
    equationOfState { rho RHO_F; }
    thermodynamics  { Cp CP_F; Hf 0; }
    transport       { mu MU_F; Pr PR_F; }
}
