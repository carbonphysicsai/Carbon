# One INCENTIVE-CANARY-01 role miner's runner cycle (testnet 567). The
# instance name is the lane (minerH, minerI). Started by
# incentive-runner@<lane>.timer; it never runs on its own.
#
# The config at ~/.carbon/incentive-runner/<lane>/config.json names the lane's
# Launchpad state directory, intake and receiver. It holds no key, password
# or URL secret (scripts/dev/canary/config.py), and the runner refuses any
# hotkey that is not a registered canary or role miner.

[Unit]
Description=Carbon incentive runner %i (one cycle, testnet 567)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/carbon
Environment=PYTHONPATH=%h/carbon
ExecStart=%h/carbon/.venv/bin/python -P -m scripts.dev.canary.runner once --config %h/.carbon/incentive-runner/%i/config.json
