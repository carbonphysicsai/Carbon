        {"id": "MOTOR_V4", "source": "R3", "pointer": "/v4_disposition", "kind": "json-state", "expected_schema": "carbon.development-cheap-baseline-report.v1", "expected_family": "motor", "label": "Historical report V4 disposition; no matched Carbon advantage established", "basis": "decision-value"},
        {"id": "MOTOR_LOOKUP_RESOLVED", "source": "R3", "pointer": "/closed_bank/decision/summary/resolved", "kind": "json-number", "expected_schema": "carbon.development-cheap-baseline-report.v1", "expected_family": "motor", "label": "Historical lookup-replay resolved questions, not generalization", "basis": "verification"},
        {"id": "MOTOR_LOOKUP_TOTAL", "source": "R3", "pointer": "/closed_bank/decision/summary/total", "kind": "json-number", "expected_schema": "carbon.development-cheap-baseline-report.v1", "expected_family": "motor", "label": "Historical lookup-replay total question denominator", "basis": "verification"}
