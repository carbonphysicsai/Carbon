{
  "schema": "PUBLIC_DELIVERABLE_SOURCE_POLICY_V1",
  "repository": "carbonphysicsai/Carbon",
  "framework": [
    {
      "id": "F1",
      "path": "Business/research/deliverable-framework/TEMPLATE.md",
      "role": "template"
    },
    {
      "id": "F2",
      "path": "Business/research/deliverable-framework/deliverable.schema.json",
      "role": "schema"
    },
    {
      "id": "F3",
      "path": "Business/research/deliverable-framework/STANDARDS.md",
      "role": "standards crosswalk"
    }
  ],
  "challenges": {
    "battery-fastcharge-ageing-development-v1": {
      "sources": [
        {
          "id": "C1",
          "path": "docs/development/challenge_pipeline/COMMON_DESIGN_PACKET_V1.md",
          "role": "common design packet"
        },
        {
          "id": "C2",
          "path": "docs/development/graphite/GRAPHITE_READINESS_GATE.md",
          "role": "readiness gate specification"
        },
        {
          "id": "C3",
          "path": "docs/development/graphite/PHASE4_ATTACKER.md",
          "role": "attack scope specification, not measured coverage"
        },
        {
          "id": "R1",
          "path": "carbon/challenge_readiness/records/battery-fastcharge-ageing-development-v1.v3.json",
          "role": "readiness and reviews"
        },
        {
          "id": "R2",
          "path": "docs/development/BATTERY_ENGINEERING_VALUE_EV4.md",
          "role": "EV4 public outcomes/adverse findings"
        },
        {
          "id": "R3",
          "path": "carbon/battery/value/contracts/ev4-charge-protocol-selection.v1.json",
          "role": "development decision contract"
        },
        {
          "id": "R4",
          "path": "docs/development/evidence/ev5-2026-10-03/README.md",
          "role": "EV5 public outcome/attack/rebuild summary"
        },
        {
          "id": "R5",
          "path": "docs/development/evidence/score-value-alignment-01/README.md",
          "role": "Q1 public alignment and missing v3 legs"
        },
        {
          "id": "R6",
          "path": ".agent/tickets/VALIDATOR-26_battery_rule_v3.md",
          "role": "v3 gate plan, not implementation proof"
        },
        {
          "id": "R7",
          "path": "carbon/challenge_pipeline/readiness/Q1_PANELS.md",
          "role": "Q1 evidence/mask mapping"
        },
        {
          "id": "C4",
          "path": "docs/development/challenge_pipeline/BATTERY_DESIGN_PACKET_WORKED_EXAMPLE.md",
          "role": "worked battery design packet; proposed development example"
        }
      ],
      "extractors": [
        {
          "id": "EV4_FALSE_FEASIBLE",
          "source": "R2",
          "pattern": "\\*\\*(\\d+) of (\\d+) eligible real members commit at least one reference-verified false\\s+acceptance\\*\\*",
          "kind": "counts",
          "label": "EV4 reported members with false acceptance / eligible members",
          "basis": "reference-relative"
        },
        {
          "id": "EV4_H1",
          "source": "R2",
          "pattern": "### H1 \\(primary\\): (UNRESOLVED|PASS|FAIL)",
          "kind": "verdict",
          "label": "EV4 reported H1 outcome",
          "basis": "decision-value"
        },
        {
          "id": "EV5_ATTACK",
          "source": "R4",
          "pattern": "\\| Adversarial score \\| \\*\\*(PASS|FAIL)\\*\\* \\|",
          "kind": "verdict",
          "label": "EV5 reported adversarial-score verdict",
          "basis": "decision-value"
        },
        {
          "id": "EV5_COUNTEREXAMPLES",
          "source": "R4",
          "pattern": "\\*\\*Track A:\\*\\* (\\d+) of the (\\d+) Track A rebuild-identity constructions select a protocol the reference verifies infeasible",
          "kind": "counts",
          "label": "EV5 reported reference-infeasible selections / selected constructions",
          "basis": "reference-relative"
        },
        {
          "id": "EV5_REBUILDS",
          "source": "R4",
          "pattern": "(\\d+) of (\\d+) rebuilds match the frozen panel",
          "kind": "rebuilds",
          "label": "EV5 reported matching rebuilds / frozen panel",
          "basis": "verification"
        },
        {
          "id": "Q1_MISSING_V3",
          "source": "R5",
          "pattern": "V3 τ/ρ and every v3 term contribution are therefore \\*\\*(uncomputable)\\*\\*",
          "kind": "gap",
          "label": "Q1 audit reports same-panel v3 measures uncomputable (historical scope)",
          "basis": "decision-value"
        },
        {
          "id": "EV4_MODE_X",
          "source": "R2",
          "pattern": "(\\d+) in-band\\s+and (\\d+) out-of-band verified violations",
          "kind": "violations",
          "label": "EV4 reported adversarial violations: in-band / out-of-band",
          "basis": "reference-relative"
        },
        {
          "id": "EV5_MODE_X",
          "source": "R4",
          "pattern": "There are (\\d+) in-band and (\\d+) out-of-band findings in total",
          "kind": "violations",
          "label": "EV5 reported adversarial findings: in-band / out-of-band",
          "basis": "reference-relative"
        },
        {
          "id": "EV5_SIGN_ERROR",
          "source": "R4",
          "pattern": "The sign-error control's near-limit false-acceptance rate is (\\d+\\.\\d+)",
          "kind": "fraction",
          "label": "EV5 reported sign-error near-limit false-acceptance rate",
          "basis": "reference-relative"
        }
      ]
    }
  }
}
