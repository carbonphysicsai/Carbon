# syntax=docker/dockerfile:1
# The PyTorch GPU (CUDA 13) reconstruction worker (TORCH-GPU-01).
# Layered on the exact C-03 JAX worker image, like the PyTorch CPU worker, and
# never on the JAX accelerator image: torch 2.13.0+cu130 needs cuDNN 9.20 and
# the JAX CUDA 13 lock pins cuDNN 9.12, so they do not share one environment.
# It installs the exact-hashed cu130 lock, which brings its own CUDA libraries,
# and carries the PyTorch GPU determinism profile as part of its identity.
# Nothing here is qualified.
ARG WORKER_IMAGE_REF
FROM ghcr.io/astral-sh/uv:0.12.7@sha256:95f2aa1fe59274951cfe9b0cbc7972e879ff1004bc8945d130a32eb0dbd85945 AS uv
FROM ${WORKER_IMAGE_REF}
ARG WORKER_IMAGE
ARG TORCH_GPU_RECIPE_DIGEST
ARG TORCH_GPU_LOCK_DIGEST
ARG TORCH_GPU_DETERMINISM_DIGEST
USER root
COPY --from=uv /uv /tmp/uv
COPY .devcontainer/torch/torch-cu130-py311.txt /opt/carbon/torch-gpu-requirements.txt
# Every distribution already in the C-03 image, before the install.
RUN /opt/carbon-worker/bin/python -I -c "import importlib.metadata as m, json; print(json.dumps({d.metadata['Name'].lower().replace('_', '-'): d.version for d in m.distributions()}, sort_keys=True))" > /tmp/before.json
RUN test "sha256:$(sha256sum /opt/carbon/torch-gpu-requirements.txt | cut -d' ' -f1)" = "${TORCH_GPU_LOCK_DIGEST}" \
    && chmod -R u+w /opt/carbon-worker \
    && TMPDIR=/tmp /tmp/uv --no-cache pip install --python /opt/carbon-worker/bin/python \
       --require-hashes --only-binary=:all: --no-deps \
       --extra-index-url https://download.pytorch.org/whl/cu130 --index-strategy unsafe-best-match \
       -r /opt/carbon/torch-gpu-requirements.txt \
    && rm /tmp/uv \
    && chmod -R a-w /opt/carbon-worker \
    && chmod 444 /opt/carbon/torch-gpu-requirements.txt
# The C-03 JAX environment is unchanged: no distribution it had changes version.
RUN /opt/carbon-worker/bin/python -I - <<'PY'
import importlib.metadata as m
import json
import pathlib

before = json.loads(pathlib.Path("/tmp/before.json").read_text())
after = {
    d.metadata["Name"].lower().replace("_", "-"): d.version for d in m.distributions()
}
changed = sorted(k for k, v in before.items() if after.get(k) != v)
if changed:
    raise SystemExit("the cu130 lock changed the C-03 environment: " + ", ".join(changed))
PY
RUN rm /tmp/before.json
RUN WORKER_IMAGE="${WORKER_IMAGE}" TORCH_GPU_RECIPE_DIGEST="${TORCH_GPU_RECIPE_DIGEST}" TORCH_GPU_LOCK_DIGEST="${TORCH_GPU_LOCK_DIGEST}" /opt/carbon-worker/bin/python -I - <<'PY'
import json
import os
import pathlib
import re

for key in ("WORKER_IMAGE", "TORCH_GPU_RECIPE_DIGEST", "TORCH_GPU_LOCK_DIGEST"):
    if not re.fullmatch(r"sha256:[a-f0-9]{64}", os.environ[key]):
        raise SystemExit("Exact immutable image identities required")
path = pathlib.Path("/opt/carbon/worker-image-build.json")
document = json.loads(path.read_text())
document.update(base_image_digest=os.environ["WORKER_IMAGE"],
                build_recipe_digest=os.environ["TORCH_GPU_RECIPE_DIGEST"],
                lock_digest=os.environ["TORCH_GPU_LOCK_DIGEST"])
path.chmod(0o600)
path.write_text(json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n")
path.chmod(0o444)
PY
RUN chmod -R a-w /opt/carbon
# cuBLAS reads its workspace setting at initialization; the GPU profile pins it.
ENV CUBLAS_WORKSPACE_CONFIG=:4096:8
# This image rebuilds PyTorch recipes on the CUDA device (battery
# implementation 2.0): the device is the validator image's, never the recipe's.
ENV CARBON_TORCH_DEVICE=cuda
LABEL org.opencontainers.image.title="Carbon PyTorch GPU DEVELOPMENT reconstruction worker" \
      org.opencontainers.image.description="Pinned CUDA 13 PyTorch worker on the C-03 image; no scientific or security qualification" \
      org.opencontainers.image.carbon.c03.base-image="${WORKER_IMAGE}" \
      org.opencontainers.image.carbon.c03.build-recipe="${TORCH_GPU_RECIPE_DIGEST}" \
      org.opencontainers.image.carbon.c03.lock="${TORCH_GPU_LOCK_DIGEST}" \
      org.opencontainers.image.carbon.torch.gpu-determinism="${TORCH_GPU_DETERMINISM_DIGEST}"
USER 65532:65532
# The pins, the determinism label and the cuBLAS workspace are the installed
# source's own, or the build fails.
RUN TORCH_GPU_DETERMINISM_DIGEST="${TORCH_GPU_DETERMINISM_DIGEST}" /opt/carbon-worker/bin/python -I - <<'PY'
import importlib.metadata as metadata
import os

from carbon.reconstruction.torch_profile import GPU_DETERMINISM, GPU_DETERMINISM_DIGEST, GPU_PINS

for name, version, source in GPU_PINS:
    installed = metadata.version(name)
    expected = source.split("==", 1)[1]
    if installed != expected:
        raise SystemExit(f"{name} {installed} is not the pinned {expected}")
if os.environ["TORCH_GPU_DETERMINISM_DIGEST"] != GPU_DETERMINISM_DIGEST:
    raise SystemExit("the GPU determinism label is not the installed source's profile")
if os.environ.get("CUBLAS_WORKSPACE_CONFIG") != dict(GPU_DETERMINISM)["cublas_workspace_config"]:
    raise SystemExit("the image's CUBLAS_WORKSPACE_CONFIG is not the GPU profile's")
if os.environ.get("CARBON_TORCH_DEVICE") != "cuda":
    raise SystemExit("the image does not rebuild on the CUDA device")
PY
