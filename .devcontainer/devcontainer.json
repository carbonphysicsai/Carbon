{
  "name": "Carbon canonical development environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "PYTHON_VERSION": "3.11.16"
    }
  },
  "runArgs": [
    "--platform=linux/amd64"
  ],
  "workspaceFolder": "/workspaces/Carbon",
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "postCreateCommand": "./scripts/dev/bootstrap.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/Carbon/.venv/bin/python"
      }
    }
  }
}
