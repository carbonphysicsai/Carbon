# syntax=docker/dockerfile:1
# Separate trusted operator runtime; not a reconstruction worker or qualification.
FROM ghcr.io/astral-sh/uv:0.12.7@sha256:95f2aa1fe59274951cfe9b0cbc7972e879ff1004bc8945d130a32eb0dbd85945 AS uv
FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517
ARG BUNDLE_DIGEST
ARG SOURCE_REVISION
ARG SOURCE_GIT_TREE
ARG LOCK_DIGEST
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PROJECT_ENVIRONMENT=/opt/validator-venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    CARBON_VALIDATOR_IMAGE_BUNDLE_DIGEST=${BUNDLE_DIGEST} \
    PATH=/opt/validator-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates docker.io \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
# Context contains only the verified Git-derived public payload, never a checkout.
COPY runtime/ /opt/carbon/
WORKDIR /opt/carbon
RUN uv python install 3.11.16 \
    && uv sync --frozen --no-dev --no-install-project --python 3.11.16 \
       --group science-jax --group science-torch --group chain --group archive --group mcp
LABEL org.opencontainers.image.title="Carbon DEVELOPMENT validator operator runtime" \
      org.opencontainers.image.carbon.validator.source-revision="${SOURCE_REVISION}" \
      org.opencontainers.image.carbon.validator.source-git-tree="${SOURCE_GIT_TREE}" \
      org.opencontainers.image.carbon.validator.bundle="${BUNDLE_DIGEST}" \
      org.opencontainers.image.carbon.validator.lock="${LOCK_DIGEST}" \
      org.opencontainers.image.carbon.validator.sdk="11.1.0" \
      org.opencontainers.image.carbon.validator.scope="DEVELOPMENT_UNQUALIFIED_OPERATOR"
# Operator supplies its own UID/permissions, config and state at run time.
# No configuration, wallet, certificate, reference, source history or state is baked.
USER 65532:65532
ENTRYPOINT ["/opt/validator-venv/bin/python", "-m", "carbon.validator_setup"]
