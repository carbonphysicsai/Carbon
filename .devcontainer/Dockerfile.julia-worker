# syntax=docker/dockerfile:1
# The builder script requires the exact freshly built C-03 image digest.
ARG WORKER_IMAGE_REF
FROM ${WORKER_IMAGE_REF}
ARG WORKER_IMAGE
ARG JULIA_RECIPE_DIGEST
USER root
RUN /opt/carbon-worker/bin/python -I - <<'PY'
import hashlib
import io
import json
import pathlib
import tarfile
import urllib.request

url = "https://julialang-s3.julialang.org/bin/linux/x64/1.13/julia-1.13.0-linux-x86_64.tar.gz"
expected = "8975da61c128a5e5ded3e719e868da8c8781deb7ad7913d37fb99be02a81904b"
with urllib.request.urlopen(url, timeout=120) as response:
    archive = response.read(512 * 1024 * 1024 + 1)
if len(archive) > 512 * 1024 * 1024 or hashlib.sha256(archive).hexdigest() != expected:
    raise SystemExit("Julia distribution identity mismatch")
with tarfile.open(fileobj=io.BytesIO(archive), mode="r:gz") as source:
    source.extractall("/opt", filter="data")
pathlib.Path("/opt/julia-1.13.0").rename("/opt/carbon-julia")
PY
RUN WORKER_IMAGE="${WORKER_IMAGE}" JULIA_RECIPE_DIGEST="${JULIA_RECIPE_DIGEST}" /opt/carbon-worker/bin/python -I - <<'PY'
import json
import os
import pathlib
import re

path = pathlib.Path("/opt/carbon/worker-image-build.json")
document = json.loads(path.read_text())
for variable in ("WORKER_IMAGE", "JULIA_RECIPE_DIGEST"):
    if not re.fullmatch(r"sha256:[a-f0-9]{64}", os.environ[variable]):
        raise SystemExit("Exact parent and recipe required")
document["base_image_digest"] = os.environ["WORKER_IMAGE"]
document["build_recipe_digest"] = os.environ["JULIA_RECIPE_DIGEST"]
path.chmod(0o600)
path.write_text(json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n")
path.chmod(0o444)
PY
RUN /opt/carbon-julia/bin/julia --startup-file=no --history-file=no --version \
    && chmod -R a-w /opt/carbon-julia
LABEL org.opencontainers.image.title="Carbon native Julia DEVELOPMENT reference worker" \
      org.opencontainers.image.carbon.c03.base-image="${WORKER_IMAGE}" \
      org.opencontainers.image.carbon.c03.build-recipe="${JULIA_RECIPE_DIGEST}" \
      org.opencontainers.image.carbon.julia.version="1.13.0" \
      org.opencontainers.image.carbon.julia.tarball="sha256:8975da61c128a5e5ded3e719e868da8c8781deb7ad7913d37fb99be02a81904b"
USER 65532:65532
# The inherited fixed C-03 entrypoint, admission gate and scratch-only state apply.
