{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Carbon C-EA1 private-alpha archive services; unprovisioned until separately authorized",
  "Parameters": {
    "ProjectName": {"Type": "String", "Default": "carbon-alpha-archive", "AllowedPattern": "[a-z][a-z0-9-]{2,31}"},
    "VpcId": {"Type": "AWS::EC2::VPC::Id"},
    "PrivateSubnetA": {"Type": "AWS::EC2::Subnet::Id"},
    "PrivateSubnetB": {"Type": "AWS::EC2::Subnet::Id"},
    "PrivateRouteTableIds": {"Type": "List<AWS::EC2::RouteTable::Id>"},
    "SupervisorSecurityGroupId": {"Type": "AWS::EC2::SecurityGroup::Id"},
    "OperatorPrincipalArn": {"Type": "String", "AllowedPattern": "arn:aws:iam::[0-9]{12}:(role|user)/.+"},
    "SupervisorPrincipalArn": {"Type": "String", "AllowedPattern": "arn:aws:iam::[0-9]{12}:role/.+"},
    "AuditPrincipalArn": {"Type": "String", "AllowedPattern": "arn:aws:iam::[0-9]{12}:role/.+"},
    "RecoveryPrincipalArn": {"Type": "String", "AllowedPattern": "arn:aws:iam::[0-9]{12}:role/.+"},
    "DBName": {"Type": "String", "Default": "carbon_archive", "AllowedValues": ["carbon_archive"]},
    "DBAdminUsername": {"Type": "String", "Default": "carbon_archive_admin", "AllowedPattern": "[a-z][a-z0-9_]{2,62}"},
    "DBInstanceClass": {"Type": "String", "Default": "db.t4g.micro", "AllowedValues": ["db.t4g.micro"]},
    "DBAllocatedStorageGiB": {"Type": "Number", "Default": 20, "AllowedValues": [20]},
    "BackupRetentionDays": {"Type": "Number", "Default": 35, "MinValue": 7, "MaxValue": 35}
  },
  "Resources": {
    "ArchiveKey": {
      "Type": "AWS::KMS::Key",
      "Properties": {
        "Description": "Carbon alpha evidence envelope and service encryption key",
        "EnableKeyRotation": true,
        "PendingWindowInDays": 30,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {"Sid": "AccountRoot", "Effect": "Allow", "Principal": {"AWS": {"Fn::Sub": "arn:aws:iam::${AWS::AccountId}:root"}}, "Action": "kms:*", "Resource": "*"},
            {"Sid": "OperatorAdministration", "Effect": "Allow", "Principal": {"AWS": {"Ref": "OperatorPrincipalArn"}}, "Action": ["kms:Describe*", "kms:Get*", "kms:List*", "kms:PutKeyPolicy", "kms:EnableKey", "kms:DisableKey", "kms:EnableKeyRotation", "kms:DisableKeyRotation", "kms:ScheduleKeyDeletion", "kms:CancelKeyDeletion", "kms:CreateAlias", "kms:UpdateAlias", "kms:DeleteAlias", "kms:TagResource", "kms:UntagResource"], "Resource": "*"}
          ]
        },
        "Tags": [{"Key": "carbon:profile", "Value": "carbon.alpha-evidence-archive.aws.private.v1"}]
      }
    },
    "ArchiveKeyAlias": {"Type": "AWS::KMS::Alias", "Properties": {"AliasName": {"Fn::Sub": "alias/${ProjectName}"}, "TargetKeyId": {"Ref": "ArchiveKey"}}},
    "EvidenceBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"BucketKeyEnabled": true, "ServerSideEncryptionByDefault": {"SSEAlgorithm": "aws:kms", "KMSMasterKeyID": {"Fn::GetAtt": ["ArchiveKey", "Arn"]}}}]},
        "ObjectLockEnabled": true,
        "ObjectLockConfiguration": {"ObjectLockEnabled": "Enabled", "Rule": {"DefaultRetention": {"Mode": "COMPLIANCE", "Days": 90}}},
        "OwnershipControls": {"Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]},
        "PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "BlockPublicPolicy": true, "IgnorePublicAcls": true, "RestrictPublicBuckets": true},
        "VersioningConfiguration": {"Status": "Enabled"},
        "Tags": [{"Key": "carbon:profile", "Value": "carbon.alpha-evidence-archive.aws.private.v1"}]
      }
    },
    "EvidenceBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Ref": "EvidenceBucket"},
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{"Sid": "DenyInsecureTransport", "Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{"Fn::GetAtt": ["EvidenceBucket", "Arn"]}, {"Fn::Sub": "${EvidenceBucket.Arn}/*"}], "Condition": {"Bool": {"aws:SecureTransport": "false"}}}]
        }
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Carbon alpha catalogue ingress from the named supervisor only",
        "VpcId": {"Ref": "VpcId"},
        "SecurityGroupIngress": [{"IpProtocol": "tcp", "FromPort": 5432, "ToPort": 5432, "SourceSecurityGroupId": {"Ref": "SupervisorSecurityGroupId"}}],
        "SecurityGroupEgress": []
      }
    },
    "DatabaseSubnetGroup": {"Type": "AWS::RDS::DBSubnetGroup", "Properties": {"DBSubnetGroupDescription": "Carbon alpha private catalogue", "SubnetIds": [{"Ref": "PrivateSubnetA"}, {"Ref": "PrivateSubnetB"}]}},
    "Catalogue": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot",
      "Properties": {
        "AllocatedStorage": {"Ref": "DBAllocatedStorageGiB"},
        "AutoMinorVersionUpgrade": true,
        "BackupRetentionPeriod": {"Ref": "BackupRetentionDays"},
        "CopyTagsToSnapshot": true,
        "DBInstanceClass": {"Ref": "DBInstanceClass"},
        "DBName": {"Ref": "DBName"},
        "DBSubnetGroupName": {"Ref": "DatabaseSubnetGroup"},
        "DeletionProtection": true,
        "EnableIAMDatabaseAuthentication": true,
        "Engine": "postgres",
        "EngineVersion": "17.11",
        "KmsKeyId": {"Fn::GetAtt": ["ArchiveKey", "Arn"]},
        "ManageMasterUserPassword": true,
        "MasterUsername": {"Ref": "DBAdminUsername"},
        "MasterUserSecret": {"KmsKeyId": {"Fn::GetAtt": ["ArchiveKey", "Arn"]}},
        "MultiAZ": true,
        "PubliclyAccessible": false,
        "StorageEncrypted": true,
        "StorageType": "gp3",
        "VPCSecurityGroups": [{"Fn::GetAtt": ["DatabaseSecurityGroup", "GroupId"]}],
        "Tags": [{"Key": "carbon:profile", "Value": "carbon.alpha-evidence-archive.aws.private.v1"}, {"Key": "carbon:backup", "Value": "required"}]
      }
    },
    "SupervisorRuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": {"Ref": "SupervisorPrincipalArn"}}, "Action": "sts:AssumeRole"}]},
        "MaxSessionDuration": 3600,
        "Policies": [{"PolicyName": "carbon-alpha-supervisor", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": ["s3:ListBucket", "s3:GetBucketVersioning"], "Resource": {"Fn::GetAtt": ["EvidenceBucket", "Arn"]}, "Condition": {"StringLike": {"s3:prefix": ["carbon-alpha-v1/*"]}}},
          {"Effect": "Allow", "Action": ["s3:GetObject", "s3:GetObjectAttributes", "s3:GetObjectRetention", "s3:GetObjectTagging", "s3:PutObject", "s3:PutObjectRetention", "s3:PutObjectTagging"], "Resource": {"Fn::Sub": "${EvidenceBucket.Arn}/carbon-alpha-v1/*"}},
          {"Effect": "Allow", "Action": ["kms:GenerateDataKey", "kms:Decrypt", "kms:DescribeKey"], "Resource": {"Fn::GetAtt": ["ArchiveKey", "Arn"]}, "Condition": {"StringEquals": {"kms:EncryptionContext:carbon:profile": "carbon.alpha-evidence-archive.aws.private.v1"}}},
          {"Effect": "Allow", "Action": "rds-db:connect", "Resource": {"Fn::Sub": "arn:aws:rds-db:${AWS::Region}:${AWS::AccountId}:dbuser/${Catalogue.DbiResourceId}/carbon_archive_supervisor"}}
        ]}}]
      }
    },
    "AuditRuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": {"Ref": "AuditPrincipalArn"}}, "Action": "sts:AssumeRole"}]},
        "MaxSessionDuration": 3600,
        "Policies": [{"PolicyName": "carbon-alpha-audit", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": ["s3:ListBucket", "s3:GetBucketVersioning"], "Resource": {"Fn::GetAtt": ["EvidenceBucket", "Arn"]}, "Condition": {"StringLike": {"s3:prefix": ["carbon-alpha-v1/*"]}}},
          {"Effect": "Allow", "Action": ["s3:GetObject", "s3:GetObjectAttributes", "s3:GetObjectRetention", "s3:GetObjectTagging"], "Resource": {"Fn::Sub": "${EvidenceBucket.Arn}/carbon-alpha-v1/*"}},
          {"Effect": "Allow", "Action": "rds-db:connect", "Resource": {"Fn::Sub": "arn:aws:rds-db:${AWS::Region}:${AWS::AccountId}:dbuser/${Catalogue.DbiResourceId}/carbon_archive_audit"}}
        ]}}]
      }
    },
    "RecoveryRuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": {"Ref": "RecoveryPrincipalArn"}}, "Action": "sts:AssumeRole"}]},
        "MaxSessionDuration": 3600,
        "Policies": [{"PolicyName": "carbon-alpha-recovery", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": ["s3:GetBucketVersioning", "s3:ListBucket", "s3:ListBucketVersions"], "Resource": {"Fn::GetAtt": ["EvidenceBucket", "Arn"]}, "Condition": {"StringLike": {"s3:prefix": ["carbon-alpha-v1/*"]}}},
          {"Effect": "Allow", "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectVersionAttributes"], "Resource": {"Fn::Sub": "${EvidenceBucket.Arn}/carbon-alpha-v1/*"}},
          {"Effect": "Allow", "Action": ["kms:Decrypt", "kms:DescribeKey"], "Resource": {"Fn::GetAtt": ["ArchiveKey", "Arn"]}},
          {"Effect": "Allow", "Action": "rds-db:connect", "Resource": {"Fn::Sub": "arn:aws:rds-db:${AWS::Region}:${AWS::AccountId}:dbuser/${Catalogue.DbiResourceId}/carbon_archive_recovery"}}
        ]}}]
      }
    },
    "S3GatewayEndpoint": {"Type": "AWS::EC2::VPCEndpoint", "Properties": {"ServiceName": {"Fn::Sub": "com.amazonaws.${AWS::Region}.s3"}, "VpcEndpointType": "Gateway", "VpcId": {"Ref": "VpcId"}, "RouteTableIds": {"Ref": "PrivateRouteTableIds"}, "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": [{"Fn::GetAtt": ["SupervisorRuntimeRole", "Arn"]}, {"Fn::GetAtt": ["AuditRuntimeRole", "Arn"]}, {"Fn::GetAtt": ["RecoveryRuntimeRole", "Arn"]}]}, "Action": ["s3:GetBucketVersioning", "s3:ListBucket", "s3:ListBucketVersions"], "Resource": {"Fn::GetAtt": ["EvidenceBucket", "Arn"]}}, {"Effect": "Allow", "Principal": {"AWS": [{"Fn::GetAtt": ["SupervisorRuntimeRole", "Arn"]}, {"Fn::GetAtt": ["AuditRuntimeRole", "Arn"]}, {"Fn::GetAtt": ["RecoveryRuntimeRole", "Arn"]}]}, "Action": ["s3:GetObject", "s3:GetObjectAttributes", "s3:GetObjectRetention", "s3:GetObjectTagging", "s3:GetObjectVersion", "s3:GetObjectVersionAttributes", "s3:PutObject", "s3:PutObjectRetention", "s3:PutObjectTagging"], "Resource": {"Fn::Sub": "${EvidenceBucket.Arn}/carbon-alpha-v1/*"}}]}}},
    "KmsEndpointSecurityGroup": {"Type": "AWS::EC2::SecurityGroup", "Properties": {"GroupDescription": "Carbon alpha supervisor to KMS endpoint", "VpcId": {"Ref": "VpcId"}, "SecurityGroupIngress": [{"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "SourceSecurityGroupId": {"Ref": "SupervisorSecurityGroupId"}}], "SecurityGroupEgress": []}},
    "KmsInterfaceEndpoint": {"Type": "AWS::EC2::VPCEndpoint", "Properties": {"PrivateDnsEnabled": true, "SecurityGroupIds": [{"Fn::GetAtt": ["KmsEndpointSecurityGroup", "GroupId"]}], "ServiceName": {"Fn::Sub": "com.amazonaws.${AWS::Region}.kms"}, "SubnetIds": [{"Ref": "PrivateSubnetA"}], "VpcEndpointType": "Interface", "VpcId": {"Ref": "VpcId"}, "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": [{"Fn::GetAtt": ["SupervisorRuntimeRole", "Arn"]}, {"Fn::GetAtt": ["RecoveryRuntimeRole", "Arn"]}]}, "Action": ["kms:Decrypt", "kms:DescribeKey", "kms:GenerateDataKey"], "Resource": {"Fn::GetAtt": ["ArchiveKey", "Arn"]}}]}}},
    "BackupVault": {"Type": "AWS::Backup::BackupVault", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain", "Properties": {"BackupVaultName": {"Fn::Sub": "${ProjectName}-vault"}, "EncryptionKeyArn": {"Fn::GetAtt": ["ArchiveKey", "Arn"]}}},
    "BackupRole": {"Type": "AWS::IAM::Role", "Properties": {"AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "backup.amazonaws.com"}, "Action": "sts:AssumeRole"}]}, "ManagedPolicyArns": ["arn:aws:iam::aws:policy/service-role/AWSBackupServiceRolePolicyForBackup"]}},
    "BackupPlan": {"Type": "AWS::Backup::BackupPlan", "Properties": {"BackupPlan": {"BackupPlanName": {"Fn::Sub": "${ProjectName}-daily"}, "BackupPlanRule": [{"RuleName": "daily-rds", "TargetBackupVault": {"Ref": "BackupVault"}, "ScheduleExpression": "cron(0 3 * * ? *)", "StartWindowMinutes": 60, "CompletionWindowMinutes": 360, "Lifecycle": {"DeleteAfterDays": 90}}]}}},
    "BackupSelection": {"Type": "AWS::Backup::BackupSelection", "Properties": {"BackupPlanId": {"Ref": "BackupPlan"}, "BackupSelection": {"IamRoleArn": {"Fn::GetAtt": ["BackupRole", "Arn"]}, "SelectionName": "catalogue", "Resources": [{"Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:db:${Catalogue}"}]}}}
  },
  "Outputs": {
    "ProfileId": {"Value": "carbon.alpha-evidence-archive.aws.private.v1"},
    "BucketName": {"Value": {"Ref": "EvidenceBucket"}},
    "CatalogueEndpoint": {"Value": {"Fn::GetAtt": ["Catalogue", "Endpoint.Address"]}},
    "CataloguePort": {"Value": {"Fn::GetAtt": ["Catalogue", "Endpoint.Port"]}},
    "CatalogueResourceId": {"Value": {"Fn::GetAtt": ["Catalogue", "DbiResourceId"]}},
    "KmsKeyArn": {"Value": {"Fn::GetAtt": ["ArchiveKey", "Arn"]}},
    "BackupVaultName": {"Value": {"Ref": "BackupVault"}}
    ,"SupervisorRuntimeRoleArn": {"Value": {"Fn::GetAtt": ["SupervisorRuntimeRole", "Arn"]}}
    ,"AuditRuntimeRoleArn": {"Value": {"Fn::GetAtt": ["AuditRuntimeRole", "Arn"]}}
    ,"RecoveryRuntimeRoleArn": {"Value": {"Fn::GetAtt": ["RecoveryRuntimeRole", "Arn"]}}
  }
}
