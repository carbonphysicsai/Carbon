{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carbon.example.invalid/hoh/v1/iteration-plan.schema.json",
  "title": "IterationPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "packet_type", "run_id", "iteration", "bindings",
    "ordered_requirement_ids", "actions", "context_requests", "blocker"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_type": {"const": "iteration_plan"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "iteration": {"type": "integer", "minimum": 1},
    "bindings": {"$ref": "#/$defs/bindings"},
    "ordered_requirement_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/requirement_id"}
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "summary", "allowed_paths"],
        "properties": {
          "requirement_id": {"$ref": "#/$defs/requirement_id"},
          "summary": {"type": "string", "minLength": 1},
          "allowed_paths": {"$ref": "#/$defs/paths"}
        }
      }
    },
    "context_requests": {"$ref": "#/$defs/paths"},
    "blocker": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["BLOCKED_HUMAN", "BLOCKED_INFRA"]},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  },
  "$defs": {
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirement_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_commit", "authority_tree", "ticket_sha256", "requirements_sha256", "candidate_head", "candidate_tree", "planner_profile_digest"],
      "properties": {
        "authority_commit": {"$ref": "#/$defs/oid"}, "authority_tree": {"$ref": "#/$defs/oid"},
        "ticket_sha256": {"$ref": "#/$defs/sha"}, "requirements_sha256": {"$ref": "#/$defs/sha"},
        "candidate_head": {"$ref": "#/$defs/oid"}, "candidate_tree": {"$ref": "#/$defs/oid"},
        "planner_profile_digest": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
