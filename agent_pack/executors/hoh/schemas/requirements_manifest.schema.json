{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carbon.example.invalid/hoh/v1/requirements-manifest.schema.json",
  "title": "RequirementsManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "ticket", "requirements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_blob", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "exact_text", "required", "authority_path"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
          "exact_text": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "authority_path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
